# BugLens Frontend — Environment Variables
#
# Copy this file to .env.local and fill in the values.
# .env.local is git-ignored and never committed.
#
# In Cloudflare Pages: set these in Settings → Environment variables.
# Vite replaces import.meta.env.VITE_* variables at build time.

# URL of the deployed FastAPI backend (no trailing slash)
# Example: https://buglens-core-3d8d2493.onrender.com
VITE_API_URL=http://localhost:8000/api/v1
